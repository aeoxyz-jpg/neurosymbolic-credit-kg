# Fuseki admin password — used by docker-compose to seed the admin account
# on first boot. Change before running `docker compose up -d`.
FUSEKI_ADMIN_PASSWORD=changeme

# Fuseki dataset name (default matches scripts/load_ontology.py)
FUSEKI_DATASET=credit-risk

# Fuseki endpoint (host machine — Python on host, Fuseki in Docker)
FUSEKI_URL=http://localhost:3030

# --- Phase D: Ollama (local daemon) ---
# Ollama runs as a local daemon on 11434. No API key — the daemon handles
# cloud routing internally via `ollama signin`. `:cloud`-suffixed models are
# proxied to ollama.com transparently; plain names are served locally.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL_FAST=gemini-3-flash-preview:cloud
OLLAMA_MODEL_DEEP=glm-5.1:cloud

                          <swrl:arguments>
                            <rdf:Description>
                              <rdf:first rdf:resource="urn:swrl#v"/>
                              <rdf:rest>
                                <rdf:Description>
                                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.3</rdf:first>
                                </rdf:Description>
                              </rdf:rest>
                            </rdf:Description>
                          </swrl:arguments>
                        </swrl:BuiltinAtom>
                      </rdf:first>
                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="https://nikko.dev/ontology/credit#hasRiskTier"/>
          <swrl:argument1 rdf:resource="urn:swrl#app"/>
          <swrl:argument2 rdf:resource="https://nikko.dev/ontology/credit#HighRiskApplication"/>

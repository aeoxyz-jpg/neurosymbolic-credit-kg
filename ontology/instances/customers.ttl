## customers.ttl — A-Box: 20 applicants + supporting orgs
##
## Distribution by intended tier (after Pellet runs in Phase B):
##   - 7 Prime    (FICO ≥ 740, DTI ≤ 0.36, employment ≥ 2)
##   - 7 NearPrime (620 ≤ FICO < 740)
##   - 6 Subprime (FICO < 620)
##
## All applicants are hand-crafted so that NB02 can predict exact tier counts.

@prefix :     <https://nikko.dev/ontology/credit#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

##############################################################################
# Supporting organizations
##############################################################################

:Bureau_Equifax a :CreditBureau ; rdfs:label "Equifax" .
:Bureau_Experian a :CreditBureau ; rdfs:label "Experian" .
:Bureau_TransUnion a :CreditBureau ; rdfs:label "TransUnion" .

:Employer_Acme a :Employer ; rdfs:label "Acme Corp" .
:Employer_Globex a :Employer ; rdfs:label "Globex Industries" .
:Employer_InitechFreelance a :Employer ; rdfs:label "Initech (1099 contractor)" .
:Employer_StartupX a :Employer ; rdfs:label "StartupX" .

##############################################################################

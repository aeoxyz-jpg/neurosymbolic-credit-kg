##############################################################################

:App_M01 a :MortgageApplication ;
    :hasApplicant :Applicant_P01 ;
    :requestedAmount 450000.00 ; :requestedTermMonths 360 ;
    :emittedSignal :Sig_M01_credit, :Sig_M01_emp .
:Sig_M01_credit a :CreditScoreSignal ;
